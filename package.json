{
  "name": "blue-ridge-sovereign",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 3005",
    "pages:build": "npm run build",
    "build": "node scripts/build-posts.js && npx tsx scripts/verify-schemas.ts && ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG=none astro build && (cp -r dist/client/* dist/ 2>/dev/null || true) && (mkdir -p .vercel/output/static && cp -r dist/client/* .vercel/output/static/ 2>/dev/null || true)",
    "postbuild": "npx tsx scripts/trigger-indexnow.ts || echo 'IndexNow skipped'",
    "preview": "astro preview",
    "start": "astro preview",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "test": "jest"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@next/third-parties": "^14.2.3",
    "@types/dompurify": "^3.0.5",
    "astro": "^7.2.10",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.2.4",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.3.0",
    "vercel": "^54.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.5.0",
    "cheerio": "^1.2.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "postcss": "^8.5.12",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-slug": "^5.1.0",
    "remark-gfm": "^3.0.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  }
}
