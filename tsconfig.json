{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client"]
  },
  "include": [
    ".astro/types.d.ts",
    "functions/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "functions/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "legacy_next_app",
    "dist",
    ".astro"
  ]
}
