---
import Layout from '../../layouts/Layout.astro';
import HomePageClient from '../../components/HomePageClient';

export const prerender = true;
---

<Layout
  title="परंजपे ब्लू रिज हिंजवडी | प्रीमियम २, ३, ४ आणि ५ बीएचके लक्झरी अपार्टमेंट्स पुणे"
  description="परंजपे ब्लू रिज हिंजवडी फेज १ मधील १३८ एकरचा भव्य टाउनशिप प्रकल्प. गोल्फ कोर्स, बोट क्लब आणि वॉक-टू-वर्क सुविधेसह आलिशान २, ३ आणि ४ बीएचके घरे."
  pathname="/mr"
  ogImage="https://paranjapeblueridge.com/assets/images/pscl-blue-ridge-aerial-drone.webp"
  lang="mr"
>
  <HomePageClient client:load />

  <div class="container mx-auto px-6 py-12 border-t border-slate-200 text-xs text-slate-500 space-y-4 [&_a]:text-[#B88E3E] hover:[&_a]:text-[#8F6A24] [&_a]:underline">
    <h2 id="speakable-title" class="text-sm font-bold text-[#070D1A]">परंजपे ब्लू रिज हिंजवडी — पुण्याच्या १३८ एकर टाउनशिपमधील आलिशान घरे</h2>
    <p id="speakable-summary" class="leading-relaxed text-slate-600">
      परंजपे ब्लू रिज पुणे मध्ये आपले स्वागत आहे. राजीव गांधी इन्फोटेक पार्क जवळ हिंजवडी फेज १ मध्ये स्थित १३८ एकरचा अग्रगण्य इंटिग्रेटेड टाउनशिप प्रकल्प. प्रॉमनेड, द अल्टियस आणि रिजेस ४१ सह २, ३, ४ आणि ५ बीएचके घरे उपलब्ध. टाउनशिपमध्ये ९-होल गोल्फ कोर्स, ब्लू रिज पब्लिक स्कूल (ICSE) आणि मुला नदीवर खाजगी बोट क्लब उपलब्ध आहे.
    </p>
  </div>
</Layout>
