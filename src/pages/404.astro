---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/master-data';

export const prerender = true;
---

<Layout
  title="Page Not Found (404) | Paranjape Blue Ridge Hinjewadi"
  description="The requested page could not be located. Explore luxury 2, 3 & 4 BHK apartments at Paranjape Blue Ridge Hinjewadi Phase 1, Pune."
  pathname="/404"
  noindex={true}
>
  <section class="min-h-[75vh] flex items-center justify-center container mx-auto px-4 py-24 text-center">
    <div className="max-w-xl mx-auto bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-xl space-y-6">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-xs font-mono text-[#8F6A24] uppercase tracking-widest font-bold">
        404 • Page Not Located
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif text-[#070D1A] font-normal">
        Page Not Found
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed font-sans max-w-md mx-auto">
        The requested URL may have moved or been updated. Explore the three premier residential clusters at Paranjape Blue Ridge:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        {projects.map((p) => (
          <a href={`/${p.slug}`} class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#B88E3E] text-xs font-bold text-[#070D1A] hover:text-[#8F6A24] transition-all block no-underline shadow-sm">
            {p.name}
          </a>
        ))}
      </div>

      <div class="pt-4">
        <a href="/" class="btn-champagne px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest no-underline inline-block shadow-sm">
          &larr; Return to Blue Ridge Home
        </a>
      </div>
    </div>
  </section>
</Layout>
