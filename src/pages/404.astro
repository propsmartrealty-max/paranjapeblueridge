---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/master-data';

export const prerender = true;
---

<Layout
  title="Page Not Found (404) | Paranjape Blue Ridge Hinjewadi"
  description="The requested page could not be located. Explore luxury 2, 3 & 4 BHK apartments at Paranjape Blue Ridge Hinjewadi Phase 1, Pune."
  pathname="/404"
  noindex={true}
>
  <section class="min-h-[75vh] flex items-center justify-center container mx-auto px-4 py-24 text-center">
    <div className="max-w-xl mx-auto bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-xl space-y-6">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-xs font-mono text-[#8F6A24] uppercase tracking-widest font-bold">
        404 • Page Not Located
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif text-[#070D1A] font-normal">
        Page Not Found
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed font-sans max-w-md mx-auto">
        The requested URL may have moved or been updated. Explore the three premier residential clusters at Paranjape Blue Ridge:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        {projects.map((p) => (
          <a href={`/${p.slug}`} class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#B88E3E] text-xs font-bold text-[#070D1A] hover:text-[#8F6A24] transition-all block no-underline shadow-sm">
            {p.name}
          </a>
        ))}
      </div>

      <div class="pt-4">
        <a href="/" class="btn-champagne px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest no-underline inline-block shadow-sm">
          &larr; Return to Blue Ridge Home
        </a>
      </div>
    </div>
  </section>

  <!-- Intelligent Client-Side Canonical Recovery for Legacy Search Engine URLs -->
  <script is:inline>
    (function() {
      try {
        var path = window.location.pathname.toLowerCase();
        if (path === '/404' || path === '/404.html') return;

        var target = null;
        if (path.indexOf('tower-') !== -1 || path.indexOf('blue-ridge-tower') !== -1) {
          target = '/';
        } else if (path.indexOf('athashri') !== -1) {
          target = '/paranjape-athashri-senior-living-pune';
        } else if (path.indexOf('cost-sheet') !== -1 || path.indexOf('price-list') !== -1) {
          target = '/paranjape-blue-ridge-price-list-and-cost-sheet-2026';
        } else if (path.indexOf('resale') !== -1) {
          target = '/blue-ridge-hinjewadi-resale-flats-and-inventory';
        } else if (path.indexOf('golf') !== -1) {
          target = '/blue-ridge-golf-course';
        } else if (path.indexOf('school') !== -1) {
          target = '/blue-ridge-public-school';
        } else if (path.indexOf('boat') !== -1 || path.indexOf('marina') !== -1) {
          target = '/blue-ridge-boat-club';
        } else if (path.indexOf('promenade') !== -1) {
          target = '/paranjape-blue-ridge-promenade-hinjewadi-pune';
        } else if (path.indexOf('altius') !== -1) {
          target = '/paranjape-blue-ridge-the-altius-hinjewadi-pune';
        } else if (path.indexOf('ridges') !== -1 || path.indexOf('41') !== -1) {
          target = '/paranjape-blue-ridge-41-hinjewadi-pune';
        } else if (path.indexOf('sez') !== -1 || path.indexOf('tech-park') !== -1) {
          target = '/blue-ridge-sez-tech-park';
        } else if (path.indexOf('metro') !== -1) {
          target = '/flats-near-hinjewadi-phase-1-metro-station';
        } else if (path.indexOf('mula-river') !== -1) {
          target = '/mula-river-rejuvenation-and-promenade-at-blue-ridge';
        } else if (path.indexOf('township') !== -1) {
          target = '/integrated-townships-in-pune-real-estate';
        } else if (path.indexOf('hinjewadi') !== -1) {
          target = '/hinjewadi-micro-market';
        }

        if (target && target !== path) {
          window.location.replace(target);
        }
      } catch (e) {}
    })();
  </script>
</Layout>
