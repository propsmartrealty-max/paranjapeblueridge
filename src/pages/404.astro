---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/master-data';

export const prerender = true;
---

<Layout
  title="Page Not Found (404) | Paranjape Blue Ridge Hinjewadi"
  description="The requested page could not be located. Explore luxury 2, 3 & 4 BHK apartments at Paranjape Blue Ridge Hinjewadi Phase 1, Pune."
  pathname="/404"
>
  <section class="min-h-[70vh] flex items-center justify-center container mx-auto px-4 py-20 text-center">
    <div class="max-w-xl mx-auto ultra-glass-card p-8 sm:p-12 rounded-3xl border border-gold/30">
      <span class="text-xs font-mono text-gold uppercase tracking-widest font-bold">404 Error • Protocol Divergence</span>
      <h1 class="text-4xl sm:text-5xl font-serif text-warm-white font-bold mt-3 mb-4">
        Page Not Found
      </h1>
      <p class="text-sm text-text-muted leading-relaxed mb-8">
        The requested URL may have moved or no longer exists. Explore available residential clusters at Paranjape Blue Ridge:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
        {projects.map((p) => (
          <a href={`/${p.slug}`} class="p-3 rounded-2xl bg-white/5 border border-white/10 hover:border-gold text-xs font-bold text-warm-white hover:text-gold transition-all block">
            {p.name}
          </a>
        ))}
      </div>

      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-gold via-gold-light to-gold text-navy font-bold text-xs uppercase tracking-widest shadow-xl hover:shadow-gold/30 transition-all">
        &larr; Return to Sovereign Homepage
      </a>
    </div>
  </section>
</Layout>
