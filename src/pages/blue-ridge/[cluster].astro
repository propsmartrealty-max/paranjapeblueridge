---
import Layout from '../../layouts/Layout.astro';
import { blueRidgeClusters, ClusterResidence } from '../../data/cms/clusters';
import IndependentClusterDetail from '../../components/IndependentClusterDetail';

export const prerender = true;

export function getStaticPaths() {
  return blueRidgeClusters.map((cluster) => ({
    params: { cluster: cluster.slug },
    props: { cluster }
  }));
}

interface Props {
  cluster: ClusterResidence;
}

const { cluster } = Astro.props;
---

<Layout
  title={`${cluster.name} | Paranjape Blue Ridge Hinjewadi Phase 1, Pune`}
  description={`${cluster.name} at Paranjape Blue Ridge Hinjewadi Phase 1: ${cluster.configurations}, ${cluster.carpetAreaRange}, ${cluster.towerDetails.storeys} storeys. MahaRERA: ${cluster.reraNumber}.`}
  pathname={`/blue-ridge/${cluster.slug}`}
  ogImage={cluster.heroImage}
>
  <IndependentClusterDetail clusterSlug={cluster.slug} client:load />
</Layout>
