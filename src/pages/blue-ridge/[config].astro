---
import Layout from '../../layouts/Layout.astro';
import { blueRidgeClusters } from '../../data/cms/clusters';
import { ArrowRight, CheckCircle2, Download, Eye, Trees, Waves } from 'lucide-react';

export const prerender = true;

export function getStaticPaths() {
  return [
    {
      params: { config: '2-bhk' },
      props: {
        bhkTitle: '2 Bedroom Residences',
        bhkNumber: 2,
        slug: '2-bhk',
        headline: '2 Bedroom Residences at Blue Ridge',
        tagline: 'Precision-Engineered Smart IT Homes with High Rental Yield',
        description: 'Explore verified 2 BHK apartments in Paranjape Blue Ridge Hinjewadi Phase 1. Discover floor plans, carpet areas, pricing and walk-to-work proximity to Infosys, Wipro, and TCS.',
        clusters: blueRidgeClusters.filter(c => c.configurations.includes('2'))
      }
    },
    {
      params: { config: '3-bhk' },
      props: {
        bhkTitle: '3 Bedroom Residences',
        bhkNumber: 3,
        slug: '3-bhk',
        headline: '3 Bedroom Residences at Blue Ridge',
        tagline: 'River-Facing High-Rise Residences for Growing Families',
        description: 'Explore verified 3 BHK luxury flats in Paranjape Blue Ridge Hinjewadi. Panoramic river views, private balconies, and 138-acre township amenities.',
        clusters: blueRidgeClusters.filter(c => c.configurations.includes('3'))
      }
    },
    {
      params: { config: '4-bhk' },
      props: {
        bhkTitle: '4 Bedroom Residences',
        bhkNumber: 4,
        slug: '4-bhk',
        headline: '4 Bedroom Residences at Blue Ridge',
        tagline: 'Ultra-Luxury Sky Mansions & Golfview Penthouses',
        description: 'Explore flagship 4 BHK & 5 BHK luxury apartments in Paranjape Blue Ridge. Private lift access, golf course fairway views, and unmatched exclusivity in Pune West.',
        clusters: blueRidgeClusters.filter(c => c.configurations.includes('4'))
      }
    }
  ];
}

const { bhkTitle, bhkNumber, slug, headline, tagline, description, clusters } = Astro.props;
---

<Layout
  title={`${bhkTitle} in Paranjape Blue Ridge Hinjewadi Phase 1 | Floor Plans & Price`}
  description={description}
  pathname={`/blue-ridge/${slug}`}
>
  <div class="pt-32 pb-24 bg-[#FAF9F6] text-[#070D1A]">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <!-- Header -->
      <div class="max-w-3xl mb-16">
        <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-[#8F6A24] block mb-3 font-semibold">
          Configuration Portfolio
        </span>
        <h1 class="text-4xl sm:text-6xl font-serif font-normal text-[#070D1A] tracking-tight leading-[1.08]">
          {bhkTitle} <br />
          <span class="italic font-light text-gradient-champagne">at Blue Ridge Hinjewadi</span>
        </h1>
        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          {tagline}
        </p>
      </div>

      <!-- Clusters Offering This Configuration -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {clusters.map((cluster) => (
          <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-slate-200/80 bg-white hover:border-[#B88E3E]/50 transition-all shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="glass-pill px-3 py-1 rounded-full text-[10px] font-mono uppercase text-[#070D1A] font-semibold bg-amber-50 border border-amber-200">
                  {cluster.name}
                </span>
                <span class="text-[10px] font-mono text-slate-500">
                  MahaRERA: {cluster.reraNumber}
                </span>
              </div>

              <h2 class="text-2xl font-serif text-[#070D1A] font-medium mb-3">
                {cluster.eyebrow}
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans font-normal mb-6">
                {cluster.architecturalStory}
              </p>

              <!-- Floor Plan Highlights -->
              <div class="space-y-2 pt-4 border-t border-slate-100 mb-6">
                <div class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-semibold">Verified Specifications</div>
                <div class="flex justify-between text-xs py-1 border-b border-slate-100">
                  <span class="text-slate-500">Carpet Range:</span>
                  <span class="text-[#070D1A] font-mono font-semibold">{cluster.carpetAreaRange}</span>
                </div>
                <div class="flex justify-between text-xs py-1 border-b border-slate-100">
                  <span class="text-slate-500">Starting Price:</span>
                  <span class="text-[#B88E3E] font-mono font-semibold">{cluster.isPriceVerified ? cluster.priceStarting : "Upon Request"}</span>
                </div>
                <div class="flex justify-between text-xs py-1">
                  <span class="text-slate-500">Possession Timeline:</span>
                  <span class="text-[#070D1A]">{cluster.possessionTimeline}</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex gap-3">
              <a
                href={`/paranjape-blue-ridge-${cluster.slug === 'ridges-41' ? '41' : cluster.slug}-hinjewadi-pune`}
                class="flex-1 py-3 rounded-xl btn-champagne text-center text-xs font-bold uppercase tracking-wider no-underline shadow-sm"
              >
                View Residence Details
              </a>
              <a
                href="/#enquiry"
                class="py-3 px-5 rounded-xl btn-glass-outline text-center text-xs font-semibold uppercase tracking-wider no-underline"
              >
                Cost Sheet
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Editorial Overview -->
      <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-200/80 bg-white space-y-6 shadow-sm">
        <h3 class="text-2xl font-serif text-[#070D1A] font-medium">
          Why Choose a {bhkTitle} in Paranjape Blue Ridge?
        </h3>
        <p class="text-slate-600 text-sm leading-relaxed font-sans font-normal">
          Blue Ridge is Pune's flagship 138-acre integrated township, located at the confluence of Hinjewadi Phase 1, the upcoming Metro Line 3, and the Mula River. Investing in a {bhkTitle} here ensures unmatched lifestyle infrastructure: walk to work within Rajiv Gandhi Infotech Park & the on-site Blue Ridge SEZ, access to the 9-hole executive golf course, private marina boat club, on-campus ICSE Blue Ridge Public School, and 24/7 gated security.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-100 text-xs text-slate-700">
          <div class="flex items-center gap-2">
            <CheckCircle2 size={16} class="text-[#B88E3E] shrink-0" />
            <span>High Gross Rental Yield (4.8% - 5.6%)</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 size={16} class="text-[#B88E3E] shrink-0" />
            <span>Direct Pedestrian IT Park & SEZ Access</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 size={16} class="text-[#B88E3E] shrink-0" />
            <span>100% MahaRERA Compliant Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
