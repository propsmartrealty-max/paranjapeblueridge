---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/master-data';
import { getPseoBySlug, curatedPseoUrls } from '../../data/seo-matrix';
import SlugPageClient from '../../components/SlugPageClient';
import PseoLandingPage from '../../components/PseoLandingPage';

export function getStaticPaths() {
  const projectPaths = projects.map(p => ({ params: { slug: p.slug } }));
  const mrProjectPaths = projects.map(p => ({ params: { slug: `mr-${p.slug}` } }));
  const pseoPaths = curatedPseoUrls.map(p => ({ params: { slug: p.slug } }));

  return [
    ...projectPaths,
    ...mrProjectPaths,
    ...pseoPaths
  ];
}

const { slug } = Astro.params;

const isMarathi = slug?.startsWith('mr-');
const cleanSlug = isMarathi ? slug?.replace(/^mr-/, '') : slug;

const projectData = projects.find(p => p.slug === cleanSlug || p.id === cleanSlug);
const pseoData = !projectData && slug ? getPseoBySlug(slug) : null;

const projectMeta = projectData ? {
  promenade: {
    titleEn: "Promenade Residences Blue Ridge | Official 3, 4 BHK from ₹1.65 Cr*",
    titleMr: "प्रोमेनेड ब्लू रिज हिंजवडी | ३ व ४ बीएचके फ्लॅट्स ₹१.६५ कोटी*",
    descEn: "Promenade Residences at Paranjape Blue Ridge Hinjewadi: Official 3 & 4 BHK riverfront luxury flats from ₹1.65 Cr*. 41 storeys, golf view. MahaRERA P52100055581.",
    descMr: "परंजपे ब्लू रिज हिंजवडी फेज १ मधील प्रोमेनेड: अधिकृत ३ आणि ४ बीएचके नदीभिमुख लक्झरी फ्लॅट्स ₹१.६५ कोटी* पासून. ४१ मजले, गोल्फ व्ह्यू. महारेरा P52100055581."
  },
  altius: {
    titleEn: "The Altius Blue Ridge Hinjewadi | Official 3, 4 BHK from ₹1.80 Cr*",
    titleMr: "द आल्टियस ब्लू रिज हिंजवडी | ३ व ४ बीएचके फ्लॅट्स ₹१.८० कोटी* पासून",
    descEn: "The Altius at Paranjape Blue Ridge Hinjewadi: Ultra-luxury 3 & 4 BHK golf-view sky residences from ₹1.80 Cr*. Private lift lobby. MahaRERA P52100078116.",
    descMr: "परंजपे ब्लू रिज हिंजवडी मधील द आल्टियस: अल्ट्रा-लक्झरी ३ आणि ४ बीएचके गोल्फ-व्ह्यू स्काय रेसिडेन्सेस ₹१.८० कोटी* पासून. खाजगी लिफ्ट. महारेरा P52100078116."
  },
  ridge41: {
    titleEn: "The Ridges 41 Blue Ridge | Official 2, 3 BHK Flats from ₹97.60 L*",
    titleMr: "द रिजेस ४१ ब्लू रिज | २ व ३ बीएचके स्मार्ट फ्लॅट्स ₹९७.६० लाख* पासून",
    descEn: "The Ridges 41 at Paranjape Blue Ridge Hinjewadi: Smart 2 & 3 BHK MiVAN high-rise flats from ₹97.60 L*. Walk to IT SEZ & Metro. MahaRERA P52100000054.",
    descMr: "परंजपे ब्लू रिज हिंजवडी मधील द रिजेस ४१: स्मार्ट २ आणि ३ बीएचके मिवाण हाय-राईज फ्लॅट्स ₹९७.६० लाख* पासून. वॉक-टू-वर्क आयटी एसईझेड. महारेरा P52100000054."
  }
}[projectData.id] : null;

const title = projectData 
  ? (isMarathi ? projectMeta?.titleMr || `${projectData.name} | परंजपे ब्लू रिज हिंजवडी` : projectMeta?.titleEn || `${projectData.name} | Paranjape Blue Ridge Hinjewadi`)
  : pseoData?.title || 'Paranjape Blue Ridge';

const description = projectData
  ? (isMarathi ? projectMeta?.descMr || projectData.descriptionMr : projectMeta?.descEn || projectData.description)
  : pseoData?.description || 'Luxury residences at Paranjape Blue Ridge Hinjewadi Phase 1, Pune.';

const ogImage = projectData?.id === 'promenade'
  ? "https://paranjapeblueridge.com/assets/images/promenade-hero.png"
  : projectData?.id === 'altius'
  ? "https://paranjapeblueridge.com/assets/images/altius-hero.png"
  : projectData?.id === 'ridges-41'
  ? "https://paranjapeblueridge.com/assets/images/ridges-hero.png"
  : "https://paranjapeblueridge.com/assets/images/township-night.png";
---

<Layout
  title={title}
  description={description}
  pathname={`/${slug}`}
  ogImage={ogImage}
  lang={isMarathi ? 'mr' : 'en'}
  projectData={projectData}
  pseoData={pseoData}
>
  {projectData ? (
    <SlugPageClient project={projectData} client:load />
  ) : pseoData ? (
    <PseoLandingPage data={pseoData} client:load />
  ) : null}
</Layout>
