---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/master-data';
import ConfigPageClient from '../../components/ConfigPageClient';

export function getStaticPaths() {
  const paths: any[] = [];
  projects.forEach(p => {
    p.configurations?.forEach(c => {
      paths.push({ params: { slug: p.slug, config: c.slug } });
      paths.push({ params: { slug: `mr-${p.slug}`, config: c.slug } });
    });
  });
  return paths;
}

const { slug, config } = Astro.params;

const isMarathi = slug?.startsWith('mr-');
const englishSlug = isMarathi ? slug?.replace(/^mr-/, '') : slug;

const project = projects.find(p => p.slug === englishSlug);
const configuration = project?.configurations?.find(c => c.slug === config);

const priceStr = configuration?.price || project?.price || '';
const title = isMarathi 
  ? `${configuration?.title} — ${project?.name} ब्लू रिज (${priceStr})`
  : `${configuration?.title} — ${project?.name} Blue Ridge Hinjewadi (${priceStr})`;
  
const description = isMarathi
  ? `अधिकृत ${configuration?.title} तपशील: ${project?.name}, परंजपे ब्लू रिज हिंजवडी. कारपेट एरिया: ${configuration?.carpetArea || project?.carpetArea}. किंमत: ${priceStr}. महारेरा: ${project?.reraNumber}.`
  : `Official ${configuration?.title} at ${project?.name}, Paranjape Blue Ridge Hinjewadi. Carpet: ${configuration?.carpetArea || project?.carpetArea}. Price: ${priceStr}. MahaRERA: ${project?.reraNumber}.`;

const ogImage = configuration?.image
  ? `https://paranjapeblueridge.com${configuration.image}`
  : "https://paranjapeblueridge.com/assets/images/township-night.png";
---

<Layout
  title={title}
  description={description}
  pathname={`/${slug}/${config}`}
  ogImage={ogImage}
  lang={isMarathi ? 'mr' : 'en'}
  projectData={project}
>
  <ConfigPageClient project={project} config={configuration} client:load />
</Layout>
