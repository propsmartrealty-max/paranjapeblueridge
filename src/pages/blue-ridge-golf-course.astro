---
import Layout from '../layouts/Layout.astro';
import { Trees, CheckCircle2, Trophy, Compass, ArrowRight, Sparkles, MapPin } from 'lucide-react';

export const prerender = true;

const golfSpecs = [
  { title: "9-Hole Executive Layout", desc: "Crafted along the gentle natural contours of the Mula River corridor with par-3 challenges." },
  { title: "Floodlit Driving Range", desc: "Dedicated practice tees equipped with night floodlights for evening driving practice after work." },
  { title: "PGA Certified Academy", desc: "Professional coaching clinics for both juniors and seasoned players looking to refine handicap." },
  { title: "Private Putting Greens", desc: "Manicured bent-grass putting surfaces and sand bunker practice zones." }
];
---

<Layout
  title="9-Hole Golf Course & Academy | Paranjape Blue Ridge Hinjewadi"
  description="Experience Pune's premier 9-hole executive golf course inside Paranjape Blue Ridge, Hinjewadi Phase 1. Features floodlit driving range, PGA coaching, and fairway-facing residences."
  pathname="/blue-ridge-golf-course"
>
  <div class="bg-[#FAF9F6] text-[#070D1A] min-h-screen pt-28 sm:pt-36 pb-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      
      {/* Breadcrumb */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-[11px] font-mono uppercase tracking-wider text-[#785415] mb-8 font-bold shadow-xs">
        <a href="/" class="hover:text-[#070D1A] no-underline">Blue Ridge</a>
        <span>/</span>
        <span class="text-slate-500">Township Lifestyle</span>
        <span>/</span>
        <span class="text-[#070D1A]">9-Hole Golf Course</span>
      </div>

      {/* Hero Section */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
        <div class="lg:col-span-7 space-y-6">
          <div class="chapter-badge">
            <Trees size={12} className="text-[#785415]" />
            <span>Championship Leisure • Hinjewadi Phase 1</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[#070D1A] leading-tight">
            Championship greens <br />
            <span class="italic font-light text-gradient-champagne">in your backyard.</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-700 font-sans font-medium leading-relaxed">
            Paranjape Blue Ridge is the only integrated township in Western Pune featuring an operational, private <strong>9-hole executive golf course</strong> alongside the scenic Mula River. Enjoy tranquil morning tee times and evening twilight drives just an elevator ride down from your home.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="/#enquiry"
              class="btn-champagne px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider no-underline shadow-md inline-flex items-center gap-2"
            >
              <span>Explore Golf-Facing Residences</span>
              <ArrowRight size={14} />
            </a>
            <a
              href="/paranjape-blue-ridge-the-altius-hinjewadi-pune"
              class="btn-glass-outline px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider no-underline inline-flex items-center gap-2"
            >
              <span>View The Altius (Golf Facing)</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-3xl overflow-hidden border-2 border-slate-200 bg-white p-3 shadow-lg">
            <img 
              src="/assets/images/pscl-blue-ridge-golf.webp" 
              alt="9-Hole Executive Golf Course at Paranjape Blue Ridge Hinjewadi" 
              class="w-full h-80 sm:h-96 object-cover rounded-2xl"
            />
            <div class="grid grid-cols-3 gap-2 text-center pt-4 border-t border-slate-100 mt-2">
              <div>
                <div class="text-xl font-serif font-bold text-[#070D1A]">9 Holes</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Executive Course</div>
              </div>
              <div>
                <div class="text-xl font-serif font-bold text-[#785415]">Floodlit</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Driving Range</div>
              </div>
              <div>
                <div class="text-xl font-serif font-bold text-[#070D1A]">PGA</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Certified Pro</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Golf Specs Grid */}
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-serif font-bold text-[#070D1A]">A Quintessential Sporting Lifestyle</h2>
          <p class="text-sm text-slate-600 font-sans mt-2">Designed for both casual recreation and serious handicap improvement.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {golfSpecs.map((item, i) => (
            <div key={i} class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs hover:border-amber-300 transition-all">
              <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#785415] mb-4 font-mono font-bold text-sm">
                0{i + 1}
              </div>
              <h3 class="text-base font-serif font-bold text-[#070D1A] mb-2">{item.title}</h3>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Fairway Living Experience */}
      <div class="bg-white rounded-3xl border-2 border-slate-200 p-8 sm:p-12 mb-20 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-6 space-y-4">
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#785415] font-extrabold block">
              Direct Fairway Views
            </span>
            <h2 class="text-2xl sm:text-4xl font-serif font-bold text-[#070D1A]">
              Wake up to manicured greens and morning river breezes.
            </h2>
            <p class="text-sm text-slate-700 font-sans leading-relaxed">
              Living at The Altius Riverside or Promenade Residences provides uninterrupted high-altitude perspectives over the emerald fairways. While other Hinjewadi residences gaze onto concrete congestion, Blue Ridge offers a lush, green sanctuary that ensures lasting property value appreciation.
            </p>
            <div class="pt-2">
              <a
                href="/paranjape-blue-ridge-the-altius-hinjewadi-pune"
                class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#785415] uppercase tracking-wider hover:text-[#070D1A] no-underline"
              >
                <span>View The Altius Floor Plans & Fairway Balconies</span>
                <ArrowRight size={14} />
              </a>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="p-6 rounded-2xl bg-amber-50/50 border border-amber-200 space-y-3">
              <h3 class="text-lg font-serif font-bold text-[#785415]">Course Amenities & Privileges</h3>
              <div class="space-y-2 text-xs text-slate-700 font-sans">
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>Exclusive Resident Golf Club Membership packages</span>
                </div>
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>Weekend tournaments and corporate golf networking leagues</span>
                </div>
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>Pro shop with top-tier equipment rental and custom fitting</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
