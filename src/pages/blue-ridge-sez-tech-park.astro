---
import Layout from '../layouts/Layout.astro';
import { Briefcase, Building2, Zap, CheckCircle2, ShieldCheck, MapPin, Users, ArrowRight } from 'lucide-react';

export const prerender = true;

const corporateTenants = [
  { name: "Cognizant Technology Solutions", sector: "IT Services & AI Engineering", employees: "12,000+" },
  { name: "Infosys Phase 1 Hub", sector: "Cloud, FinTech & Enterprise Software", employees: "Adjacent Campus" },
  { name: "Tata Technologies", sector: "Automotive & Aerospace Engineering", employees: "3,500+" },
  { name: "LTIMindtree", sector: "Digital Transformation & Solutions", employees: "4,000+" },
  { name: "Wipro Technologies", sector: "Cybersecurity & IT Infrastructure", employees: "Adjacent Phase 1" },
  { name: "Accenture Digital", sector: "Cloud Consulting & Analytics", employees: "5,000+" }
];

const infraHighlights = [
  { title: "220/22 KVA Dedicated Substation", desc: "Township's captive electrical substation providing 100% uninterrupted power supply with dual-feeder redundancy." },
  { title: "Walk-to-Work Pedestrian Network", desc: "Direct covered pathways connecting residential clusters to SEZ commercial towers in under 5 minutes." },
  { title: "High-Street Dining & Retail Hub", desc: "Multi-cuisine food courts, convenience retail supermarkets, cafes, and business banking branches." },
  { title: "Enterprise Grade Connectivity", desc: "Multi-carrier high-speed optical fiber backbone with triple-redundant carrier neutral telecommunications." }
];
---

<Layout
  title="Blue Ridge IT SEZ Tech Park | Hinjewadi Phase 1, Pune"
  description="Explore the 3M+ sq. ft. Blue Ridge IT/ITES Special Economic Zone (SEZ) in Hinjewadi Phase 1. Home to Cognizant, Infosys, and top multinational tech employers with true walk-to-work living."
  pathname="/blue-ridge-sez-tech-park"
>
  <div class="bg-[#FAF9F6] text-[#070D1A] min-h-screen pt-28 sm:pt-36 pb-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      
      {/* Breadcrumb */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-[11px] font-mono uppercase tracking-wider text-[#785415] mb-8 font-bold shadow-xs">
        <a href="/" class="hover:text-[#070D1A] no-underline">Blue Ridge</a>
        <span>/</span>
        <span class="text-slate-500">Commercial Engine</span>
        <span>/</span>
        <span class="text-[#070D1A]">IT/ITES SEZ</span>
      </div>

      {/* Hero Section */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
        <div class="lg:col-span-7 space-y-6">
          <div class="chapter-badge">
            <Briefcase size={12} className="text-[#785415]" />
            <span>3M+ Sq. Ft. Commercial Campus • Hinjewadi Phase 1</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[#070D1A] leading-tight">
            The beating heart of <br />
            <span class="italic font-light text-gradient-champagne">Pune's IT economy.</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-700 font-sans font-medium leading-relaxed">
            The <strong>Blue Ridge IT/ITES Special Economic Zone (SEZ)</strong> is an economic powerhouse spanning over 3 million square feet within the 138-acre master township. Housing marquee multinational technology enterprises, it powers Pune's tech ecosystem while enabling a genuine <strong>5-minute walk-to-work lifestyle</strong> for township residents.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="/#residences"
              class="btn-champagne px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider no-underline shadow-md inline-flex items-center gap-2"
            >
              <span>Explore Walk-to-Work Residences</span>
              <ArrowRight size={14} />
            </a>
            <a
              href="/#site-visit"
              class="btn-glass-outline px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider no-underline inline-flex items-center gap-2"
            >
              <span>Schedule Township Visit</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-3xl overflow-hidden border-2 border-slate-200 bg-white p-3 shadow-lg">
            <img 
              src="/assets/images/real-township-day.jpg" 
              alt="Blue Ridge IT SEZ Commercial Campus Hinjewadi Phase 1" 
              class="w-full h-80 sm:h-96 object-cover rounded-2xl"
            />
            <div class="grid grid-cols-3 gap-2 text-center pt-4 border-t border-slate-100 mt-2">
              <div>
                <div class="text-xl font-serif font-bold text-[#070D1A]">3M+</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Sq. Ft. Built</div>
              </div>
              <div>
                <div class="text-xl font-serif font-bold text-[#785415]">25,000+</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Tech Workforce</div>
              </div>
              <div>
                <div class="text-xl font-serif font-bold text-[#070D1A]">220 KVA</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase font-bold">Substation</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Marquee Corporate Tenants */}
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-serif font-bold text-[#070D1A]">Marquee Corporate Tenants</h2>
          <p class="text-sm text-slate-600 font-sans mt-2">Global corporations operating from within or immediately adjacent to the campus.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {corporateTenants.map((corp, i) => (
            <div key={i} class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs hover:border-amber-300 transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#785415] mb-4">
                  <Building2 size={20} />
                </div>
                <h3 class="text-base font-serif font-bold text-[#070D1A] mb-1">{corp.name}</h3>
                <div class="text-xs text-slate-500 font-sans">{corp.sector}</div>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono">
                <span class="text-slate-400">Footprint:</span>
                <span class="text-[#785415] font-bold">{corp.employees}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Infrastructure Specs Grid */}
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-serif font-bold text-[#070D1A]">Grade-A Commercial Infrastructure</h2>
          <p class="text-sm text-slate-600 font-sans mt-2">Engineered to global enterprise business continuity benchmarks.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {infraHighlights.map((item, i) => (
            <div key={i} class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs hover:border-amber-300 transition-all">
              <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#785415] mb-4 font-mono font-bold text-sm">
                0{i + 1}
              </div>
              <h3 class="text-base font-serif font-bold text-[#070D1A] mb-2">{item.title}</h3>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Walk-to-Work Lifestyle Benefit */}
      <div class="bg-white rounded-3xl border-2 border-slate-200 p-8 sm:p-12 mb-20 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-6 space-y-4">
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#785415] font-extrabold block">
              Reclaim 2+ Hours Daily
            </span>
            <h2 class="text-2xl sm:text-4xl font-serif font-bold text-[#070D1A]">
              Say goodbye to Hinjewadi traffic jams forever.
            </h2>
            <p class="text-sm text-slate-700 font-sans leading-relaxed">
              While colleagues spend up to two hours daily navigating highway congestion, Blue Ridge residents simply take a 5-minute shaded walk to their office. That equates to 500+ hours saved annually for family, health, sports, and well-being.
            </p>
            <div class="pt-2">
              <a
                href="/paranjape-blue-ridge-41-hinjewadi-pune"
                class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#785415] uppercase tracking-wider hover:text-[#070D1A] no-underline"
              >
                <span>Explore Ridges 41 Smart IT Residences</span>
                <ArrowRight size={14} />
              </a>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="p-6 rounded-2xl bg-amber-50/50 border border-amber-200 space-y-3">
              <h3 class="text-lg font-serif font-bold text-[#785415]">The Walk-to-Work Advantage</h3>
              <div class="space-y-2 text-xs text-slate-700 font-sans">
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>5-Minute walk from Promenade, Altius, and Ridges 41</span>
                </div>
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>High rental demand with 4.8%+ gross yields from tech executives</span>
                </div>
                <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <CheckCircle2 size={15} className="text-emerald-600 shrink-0" />
                  <span>800 meters from upcoming Hinjewadi Metro Line 3 Station</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
