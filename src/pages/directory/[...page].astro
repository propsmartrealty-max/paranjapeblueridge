---
import Layout from '../../layouts/Layout.astro';
import { getPseoTotalCount, generatePseoChunk } from '../../data/seo-matrix';

const { page } = Astro.params;

const pageNum = parseInt(page || '1', 10);
const CHUNK_SIZE = 1000;
const totalCount = getPseoTotalCount();
const totalChunks = Math.ceil(totalCount / CHUNK_SIZE);

if (isNaN(pageNum) || pageNum < 1 || pageNum > totalChunks) {
  return Astro.redirect('/directory');
}

const chunk = generatePseoChunk(pageNum - 1, CHUNK_SIZE);
const title = `Pune Real Estate Directory - Part ${pageNum} | Paranjape Blue Ridge`;
const description = `Explore part ${pageNum} of the master directory of premium real estate properties at Paranjape Blue Ridge Hinjewadi, Pune.`;
---

<Layout
  title={title}
  description={description}
  pathname={`/directory/${pageNum}`}
>
  <section class="pt-24 pb-20 container mx-auto max-w-7xl px-4">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6 border-b border-gold/20 pb-6">
      <div>
        <a href="/directory" class="text-xs font-mono text-gold flex items-center gap-2 mb-2 hover:underline">
          &larr; Back to Directory Hub
        </a>
        <h1 class="text-3xl md:text-4xl font-serif text-warm-white font-bold">
          Directory Partition <span class="text-gold font-mono">#{pageNum}</span>
        </h1>
        <p class="text-xs text-text-muted mt-1 font-mono">
          Showing {chunk.length} entries of {totalCount.toLocaleString()}
        </p>
      </div>

      <!-- Pagination Controls -->
      <div class="flex items-center gap-3 font-mono text-xs">
        {pageNum > 1 && (
          <a href={`/directory/${pageNum - 1}`} class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-gold text-warm-white transition-all">
            &larr; Prev
          </a>
        )}
        <span class="text-gold font-bold px-3 py-2 bg-gold/10 rounded-xl border border-gold/30">
          Page {pageNum} of {totalChunks}
        </span>
        {pageNum < totalChunks && (
          <a href={`/directory/${pageNum + 1}`} class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-gold text-warm-white transition-all">
            Next &rarr;
          </a>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {chunk.map((item) => (
        <a href={`/${item.slug}`} class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-gold/40 hover:bg-gold/5 transition-all block group">
          <h3 class="text-xs font-bold text-warm-white group-hover:text-gold transition-colors line-clamp-2">
            {item.title}
          </h3>
          <span class="text-[10px] text-text-muted mt-1 block font-mono">
            {item.location}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
