---
import Layout from '../../layouts/Layout.astro';
import { getPseoTotalCount } from '../../data/seo-matrix';
import { projects, articles } from '../../data/master-data';
import { getAllPosts } from '../../utils/mdxUtils';

export const prerender = true;

const totalCount = getPseoTotalCount();
const mdxPosts = getAllPosts();

const CHUNK_SIZE = 1000;
const totalChunks = Math.ceil(totalCount / CHUNK_SIZE);
const chunksArray = Array.from({ length: totalChunks }, (_, i) => i + 1);
---

<Layout
  title="Pune Real Estate Directory | Paranjape Blue Ridge"
  description="Explore the definitive master directory of over 150,000 premium real estate properties, configurations, and insights across the entire Pune market."
  pathname="/directory"
>
  <section class="pt-24 pb-20 container mx-auto max-w-7xl px-4">
    <div class="max-w-3xl mb-12">
      <span class="inline-block px-3.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-[#8F6A24] text-xs font-semibold mb-4 tracking-widest uppercase font-mono">
        Sovereign Master Index
      </span>
      <h1 class="text-4xl md:text-5xl font-serif text-[#070D1A] mb-4 font-normal">
        Pune Real Estate Directory
      </h1>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        A comprehensive, structured index of over {totalCount.toLocaleString()} premium real estate properties, micro-markets, and configurations at Paranjape Blue Ridge Hinjewadi, Pune.
      </p>
    </div>

    <div class="space-y-12">
      <!-- Core Projects -->
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-serif text-[#070D1A] mb-6 border-b border-slate-200 pb-3 font-bold flex items-center justify-between">
          <span>Core Residential Projects</span>
          <span class="text-xs font-mono text-[#8F6A24]">3 Flagship Enclaves</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {projects.map((project) => (
            <a href={`/${project.slug}`} class="p-4 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#B88E3E] text-slate-800 hover:text-[#8F6A24] transition-all text-sm font-semibold no-underline shadow-xs block">
              {project.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Insights & Articles -->
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-serif text-[#070D1A] mb-6 border-b border-slate-200 pb-3 font-bold flex items-center justify-between">
          <span>Real Estate Insights & Editorial Intelligence</span>
          <span class="text-xs font-mono text-[#8F6A24]">Research Papers</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {articles.map((article) => (
            <a href={`/insights/${article.slug}`} class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#B88E3E] text-slate-700 hover:text-[#8F6A24] transition-all text-xs font-medium no-underline block leading-relaxed">
              {article.title}
            </a>
          ))}
          {mdxPosts.map((post) => (
            <a href={`/insights/${post.slug}`} class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#B88E3E] text-slate-700 hover:text-[#8F6A24] transition-all text-xs font-medium no-underline block leading-relaxed">
              {post.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Programmatic Partitions -->
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-serif text-[#070D1A] mb-6 border-b border-slate-200 pb-3 font-bold flex items-center justify-between">
          <span>Programmatic Location & Configuration Partitions</span>
          <span class="text-xs font-mono text-slate-500">{totalChunks} Total Pages</span>
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
          {chunksArray.map((chunkNum) => (
            <a href={`/directory/${chunkNum}`} class="p-3 bg-slate-50 border border-slate-200 hover:border-[#B88E3E] rounded-xl text-center text-xs font-mono text-slate-700 hover:text-[#8F6A24] transition-all no-underline">
              Partition {chunkNum}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
