---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../utils/mdxUtils';
import { articles } from '../../data/master-data';

export const prerender = true;

const mdxPosts = getAllPosts();
const allArticleMap = new Map();

for (const post of mdxPosts) {
  if (!post) continue;
  allArticleMap.set(post.slug, {
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    dateISO: post.dateISO,
    date: post.date,
    category: post.category || 'Real Estate Intelligence',
    author: post.author || 'Paranjape Research Team',
  });
}

for (const art of articles) {
  if (!allArticleMap.has(art.slug)) {
    allArticleMap.set(art.slug, {
      slug: art.slug,
      title: art.title,
      excerpt: art.excerpt,
      dateISO: art.dateISO,
      category: art.category || 'Investment Analysis',
      author: art.author || 'Paranjape Insights',
    });
  }
}

const allArticles = Array.from(allArticleMap.values());
---

<Layout
  title="Insights & Research — Paranjape Blue Ridge Hinjewadi | Real Estate Intelligence"
  description="Expert insights on Paranjape Blue Ridge Hinjewadi: price trends, Metro Line 3 impact, school guides, NRI investment strategies, and deep-dives."
  pathname="/insights"
>
  <section class="pt-24 pb-20 container mx-auto max-w-7xl px-4">
    <div class="mb-12">
      <span class="text-xs font-mono text-gold tracking-widest uppercase font-bold">Research & Monograph Hub</span>
      <h1 class="text-4xl md:text-5xl font-serif text-warm-white font-bold mt-2 mb-4">
        Blue Ridge Real Estate <span class="italic font-normal text-gilded">Intelligence</span>
      </h1>
      <p class="text-text-muted text-base max-w-2xl leading-relaxed">
        Authoritative market intelligence, infrastructure impact reports, price appreciation analyses, and micro-market monographs on Hinjewadi and West Pune.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((art) => (
        <a href={`/insights/${art.slug}`} class="ultra-glass-card p-6 rounded-3xl border border-gold/20 hover:border-gold/50 transition-all block group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[9px] font-mono font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-gold/10 text-gold border border-gold/25">
                {art.category}
              </span>
              <span class="text-[10px] text-text-muted font-mono">
                {art.dateISO || art.date}
              </span>
            </div>
            <h2 class="text-base font-serif font-bold text-warm-white group-hover:text-gold transition-colors leading-snug mb-3">
              {art.title}
            </h2>
            <p class="text-xs text-text-muted leading-relaxed line-clamp-3">
              {art.excerpt}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-gold font-bold">
            <span>Read Monograph &rarr;</span>
            <span class="text-[10px] text-text-muted font-mono">{art.author}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
