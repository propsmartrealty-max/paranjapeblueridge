---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../utils/mdxUtils';
import { articles } from '../../data/master-data';

export const prerender = true;

const mdxPosts = getAllPosts();
const allArticleMap = new Map();

for (const post of mdxPosts) {
  if (!post) continue;
  allArticleMap.set(post.slug, {
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    dateISO: post.dateISO,
    date: post.date,
    category: post.category || 'Real Estate Intelligence',
    author: post.author || 'Paranjape Research Team',
  });
}

for (const art of articles) {
  if (!allArticleMap.has(art.slug)) {
    allArticleMap.set(art.slug, {
      slug: art.slug,
      title: art.title,
      excerpt: art.excerpt,
      dateISO: art.dateISO,
      category: art.category || 'Investment Analysis',
      author: art.author || 'Paranjape Insights',
    });
  }
}

const allArticles = Array.from(allArticleMap.values());
---

<Layout
  title="Insights & Research — Paranjape Blue Ridge Hinjewadi | Real Estate Intelligence"
  description="Expert insights on Paranjape Blue Ridge Hinjewadi: price trends, Metro Line 3 impact, school guides, NRI investment strategies, and deep-dives."
  pathname="/insights"
>
  <section class="pt-24 pb-20 container mx-auto max-w-7xl px-4">
    <div class="mb-12">
      <span class="inline-block px-3.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-[#8F6A24] text-xs font-semibold mb-3 tracking-widest uppercase font-mono">
        Research & Monograph Hub
      </span>
      <h1 class="text-4xl md:text-5xl font-serif text-[#070D1A] font-normal mt-2 mb-4">
        Blue Ridge Real Estate <span class="italic font-light text-gradient-champagne">Intelligence</span>
      </h1>
      <p class="text-slate-600 text-base max-w-2xl leading-relaxed font-sans">
        Authoritative market intelligence, infrastructure impact reports, price appreciation analyses, and micro-market monographs on Hinjewadi and West Pune.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((art) => (
        <a href={`/insights/${art.slug}`} class="bg-white p-6 rounded-3xl border border-slate-200 hover:border-[#B88E3E] shadow-sm hover:shadow-md transition-all block group flex flex-col justify-between no-underline">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[9px] font-mono font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-amber-50 text-[#8F6A24] border border-amber-200">
                {art.category}
              </span>
              <span class="text-[10px] text-slate-500 font-mono">
                {art.dateISO || art.date}
              </span>
            </div>
            <h2 class="text-base font-serif font-bold text-[#070D1A] group-hover:text-[#8F6A24] transition-colors leading-snug mb-3">
              {art.title}
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 font-sans font-normal">
              {art.excerpt}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-[#8F6A24] font-bold">
            <span>Read Monograph &rarr;</span>
            <span class="text-[10px] text-slate-400 font-mono font-normal">{art.author}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
