---
import Layout from '../../layouts/Layout.astro';
import { articles, projects } from '../../data/master-data';
import { getPostBySlug, getAllPosts } from '../../utils/mdxUtils';

export function getStaticPaths() {
  const mdxPosts = getAllPosts();
  const mdxSlugs = mdxPosts.map(p => ({ params: { slug: p.slug } }));
  const articleSlugs = articles.map(a => ({ params: { slug: a.slug } }));
  return [...mdxSlugs, ...articleSlugs];
}

const { slug } = Astro.params;

const mdxPost = slug ? getPostBySlug(slug) : null;
const staticArticle = slug ? articles.find(a => a.slug === slug) : null;

const article = mdxPost ? {
  title: mdxPost.meta?.title || 'Insight',
  excerpt: mdxPost.meta?.excerpt || mdxPost.meta?.description || '',
  slug: mdxPost.slug,
  content: mdxPost.content,
  category: mdxPost.meta?.category || 'Real Estate Intelligence',
  dateISO: mdxPost.meta?.dateISO || '2026-01-01',
  author: mdxPost.meta?.author || 'Paranjape Research Team',
} : {
  title: staticArticle?.title || 'Insight',
  excerpt: staticArticle?.excerpt || '',
  slug: staticArticle?.slug || '',
  content: Array.isArray(staticArticle?.content) ? staticArticle?.content.join('\n\n') : (staticArticle?.content || staticArticle?.excerpt || ''),
  category: staticArticle?.category || 'Investment Analysis',
  dateISO: staticArticle?.dateISO || '2026-01-01',
  author: staticArticle?.author || 'Paranjape Insights',
};

const ogImage = `https://paranjapeblueridge.com/api/og?title=${encodeURIComponent(article.title)}&config=${encodeURIComponent(article.category)}`;
---

<Layout
  title={`${article.title} | Paranjape Blue Ridge Hinjewadi`}
  description={article.excerpt}
  pathname={`/insights/${article.slug}`}
  ogImage={ogImage}
>
  <article class="pt-24 pb-20 container mx-auto max-w-4xl px-4">
    <div class="mb-8">
      <a href="/insights" class="text-xs font-mono text-[#8F6A24] flex items-center gap-2 mb-4 hover:underline">
        &larr; Back to Insights Hub
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 text-[#8F6A24] border border-amber-200">
          {article.category}
        </span>
        <span class="text-xs text-slate-500 font-mono">{article.dateISO}</span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500 font-mono">By {article.author}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-[#070D1A] font-normal leading-tight mb-6">
        {article.title}
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed font-sans border-l-2 border-[#B88E3E] pl-4 italic">
        {article.excerpt}
      </p>
    </div>

    <!-- Monograph Body -->
    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-sm max-w-none text-slate-700 space-y-6 leading-relaxed font-sans [&_h2]:text-2xl [&_h2]:font-serif [&_h2]:font-bold [&_h2]:text-[#070D1A] [&_h2]:mt-8 [&_h3]:text-xl [&_h3]:font-serif [&_h3]:text-[#8F6A24] [&_p]:text-sm sm:[&_p]:text-base [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_li]:text-sm">
      <div set:html={article.content.replace(/\n\n/g, '<br/><br/>')} />
    </div>

    <!-- Related Projects CTA -->
    <div class="mt-12 p-8 rounded-3xl bg-amber-50/70 border border-amber-200 text-center shadow-xs">
      <h3 class="text-2xl font-serif font-bold text-[#070D1A] mb-2">Explore Paranjape Blue Ridge Township</h3>
      <p class="text-xs text-slate-600 mb-6 max-w-lg mx-auto">138-Acre Integrated Township in Hinjewadi Phase 1 with 9-hole golf course, ICSE school, and luxury 2, 3 & 4 BHK residences.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {projects.map((p) => (
          <a href={`/${p.slug}`} class="px-5 py-2.5 rounded-full bg-white text-[#070D1A] border border-slate-300 hover:border-[#B88E3E] hover:text-[#8F6A24] text-xs font-bold transition-all no-underline shadow-xs">
            {p.name} &rarr;
          </a>
        ))}
      </div>
    </div>
  </article>
</Layout>
