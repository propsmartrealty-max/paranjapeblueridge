---
import Layout from '../../layouts/Layout.astro';
import { articles, projects } from '../../data/master-data';
import { getPostBySlug } from '../../utils/mdxUtils';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/insights');
}

const mdxPost = getPostBySlug(slug);
const staticArticle = articles.find(a => a.slug === slug);

if (!mdxPost && !staticArticle) {
  return Astro.redirect('/insights');
}

const article = mdxPost ? {
  title: mdxPost.meta.title || 'Insight',
  excerpt: mdxPost.meta.excerpt || mdxPost.meta.description || '',
  slug: mdxPost.slug,
  content: mdxPost.content,
  category: mdxPost.meta.category || 'Real Estate Intelligence',
  dateISO: mdxPost.meta.dateISO || '2026-01-01',
  author: mdxPost.meta.author || 'Paranjape Research Team',
} : {
  title: staticArticle.title,
  excerpt: staticArticle.excerpt,
  slug: staticArticle.slug,
  content: staticArticle.content || staticArticle.excerpt,
  category: staticArticle.category || 'Investment Analysis',
  dateISO: staticArticle.dateISO || '2026-01-01',
  author: staticArticle.author || 'Paranjape Insights',
};

const ogImage = `https://paranjapeblueridge.com/api/og?title=${encodeURIComponent(article.title)}&config=${encodeURIComponent(article.category)}`;
---

<Layout
  title={`${article.title} | Paranjape Blue Ridge Hinjewadi`}
  description={article.excerpt}
  pathname={`/insights/${article.slug}`}
  ogImage={ogImage}
>
  <article class="pt-24 pb-20 container mx-auto max-w-4xl px-4">
    <div class="mb-8">
      <a href="/insights" class="text-xs font-mono text-gold flex items-center gap-2 mb-4 hover:underline">
        &larr; Back to Insights Hub
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-gold/10 text-gold border border-gold/30">
          {article.category}
        </span>
        <span class="text-xs text-text-muted font-mono">{article.dateISO}</span>
        <span class="text-xs text-text-muted">•</span>
        <span class="text-xs text-text-muted font-mono">By {article.author}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-warm-white font-bold leading-tight mb-6">
        {article.title}
      </h1>
      <p class="text-lg text-text-light/90 leading-relaxed font-sans border-l-2 border-gold pl-4 italic">
        {article.excerpt}
      </p>
    </div>

    <!-- Monograph Body -->
    <div class="ultra-glass-card p-8 sm:p-12 rounded-3xl border border-gold/20 prose prose-invert max-w-none text-text-light/90 space-y-6 leading-relaxed font-sans [&_h2]:text-2xl [&_h2]:font-serif [&_h2]:text-warm-white [&_h2]:mt-8 [&_h3]:text-xl [&_h3]:font-serif [&_h3]:text-gold [&_p]:text-sm sm:[&_p]:text-base [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_li]:text-sm">
      <div set:html={article.content.replace(/\n\n/g, '<br/><br/>')} />
    </div>

    <!-- Related Projects CTA -->
    <div class="mt-12 p-8 rounded-3xl bg-gold/10 border border-gold/30 text-center">
      <h3 class="text-2xl font-serif font-bold text-warm-white mb-2">Explore Paranjape Blue Ridge Township</h3>
      <p class="text-xs text-text-muted mb-6 max-w-lg mx-auto">138-Acre Integrated Township in Hinjewadi Phase 1 with 9-hole golf course, ICSE school, and luxury 2, 3 & 4 BHK residences.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {projects.map((p) => (
          <a href={`/${p.slug}`} class="px-5 py-2.5 rounded-full bg-navy text-warm-white border border-gold/30 text-xs font-bold hover:bg-gold hover:text-navy transition-all">
            {p.name} &rarr;
          </a>
        ))}
      </div>
    </div>
  </article>
</Layout>
